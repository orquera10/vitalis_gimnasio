# ==============================================================================
# VITALIS FITNESS CLUB - VARIABLES DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para personalizar tus variables:
#   copy .env.example .env (Windows) o cp .env.example .env (Linux/Mac)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración Principal de Django
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-vitalis-change-this-in-production-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ------------------------------------------------------------------------------
# 2. Configuración de Base de Datos
# ------------------------------------------------------------------------------
# OPCIÓN A: Conexión Local/Remota a PostgreSQL
# Cambia USE_POSTGRES=True para conectar con tu instancia de PostgreSQL.
# Si USE_POSTGRES=False, Django usará automáticamente SQLite local (db.sqlite3).
USE_POSTGRES=False
DB_NAME=vitalis_gym
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# OPCIÓN B: Conexión por URL completa (Recomendado para Cloud: Neon, Supabase, Railway, Render)
# Si defines DATABASE_URL, tendrá prioridad sobre USE_POSTGRES y los parámetros individuales.
# DATABASE_URL=postgresql://usuario:contraseña@servidor.com:5432/vitalis_gym

# ------------------------------------------------------------------------------
# 3. Configuración de Correo Electrónico (Opcional)
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=581
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
